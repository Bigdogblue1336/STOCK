# Copy this file to .env (which is gitignored) and fill in what you use.
# scripts/run_daily.sh loads .env automatically before running the pipeline.

# Required for the daily Claude news analysis phase (portfolio/news.py).
# Without it, news analysis is skipped for the run (everything else still works).
ANTHROPIC_API_KEY=

# Notifier (optional, off by default). Set to "telegram" or "imessage" to enable.
PORTFOLIO_NOTIFIER=none

# Telegram channel: create a bot via @BotFather, then message it once and hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# iMessage channel (macOS only, via osascript/Messages.app): the buddy id
# (phone number or Apple ID email) to send to.
IMESSAGE_RECIPIENT=
